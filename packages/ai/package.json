{
  "name": "@demokit-ai/ai",
  "version": "0.4.1",
  "description": "AI-powered narrative generation for DemoKit (L3 generation with BYOK support)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-dts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@demokit-ai/core": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.63",
    "@mastra/core": "^1.15.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependenciesMeta": {
    "@mastra/langfuse": {
      "optional": true
    },
    "langfuse": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "sideEffects": false
}
